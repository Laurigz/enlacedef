# Datos de contacto del sitio.
# Cambiá estos valores y se actualizan en todas las páginas (botones, formulario, chat y pie).
# En Vercel podés pisarlos desde Settings → Environment Variables sin tocar este archivo.

# WhatsApp: código de país + número, solo dígitos. Ej. Argentina celular: 5491123456789
VITE_WHATSAPP=525512345678
# Cómo se muestra el número en pantalla
VITE_WHATSAPP_LABEL=+52 55 1234 5678
VITE_EMAIL=hola@enlace.digital

# Redes (opcional). Pegá la URL completa del perfil. Si queda vacío, el ícono no aparece.
VITE_INSTAGRAM=
VITE_LINKEDIN=
